{
  "entities": {
    "UserPrivate": {
      "title": "UserPrivate",
      "description": "Private user account metadata isolated from public profiles.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "maxLength": 128
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 254
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "email", "createdAt"]
    },
    "PlayerProfile": {
      "title": "PlayerProfile",
      "description": "Public player handle and per-difficulty personal best scores.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "maxLength": 128
        },
        "handle": {
          "type": "string",
          "minLength": 2,
          "maxLength": 20,
          "pattern": "^[a-zA-Z0-9_\\- ]+$"
        },
        "bestEasy": {
          "type": "integer"
        },
        "bestMedium": {
          "type": "integer"
        },
        "bestHard": {
          "type": "integer"
        },
        "bestInsane": {
          "type": "integer"
        },
        "bestExtreme": {
          "type": "integer"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "uid",
        "handle",
        "bestEasy",
        "bestMedium",
        "bestHard",
        "bestInsane",
        "bestExtreme",
        "createdAt",
        "updatedAt"
      ]
    },
    "LeaderboardEntry": {
      "title": "LeaderboardEntry",
      "description": "Best verified run per player per difficulty for the global leaderboard.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "maxLength": 128
        },
        "handle": {
          "type": "string",
          "minLength": 2,
          "maxLength": 20,
          "pattern": "^[a-zA-Z0-9_\\- ]+$"
        },
        "difficulty": {
          "type": "string",
          "enum": ["easy", "medium", "hard", "insane", "extreme"]
        },
        "score": {
          "type": "integer"
        },
        "winTarget": {
          "type": "integer"
        },
        "won": {
          "type": "boolean"
        },
        "durationMs": {
          "type": "integer"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "uid",
        "handle",
        "difficulty",
        "score",
        "winTarget",
        "won",
        "durationMs",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserPrivate" },
      "description": "Private user record storing account email (owner-only read/write)."
    },
    "/profiles/{userId}": {
      "schema": { "$ref": "#/entities/PlayerProfile" },
      "description": "Public player handle and per-difficulty personal best scores."
    },
    "/leaderboard/{entryId}": {
      "schema": { "$ref": "#/entities/LeaderboardEntry" },
      "description": "Global leaderboard records keyed by {uid}_{difficulty}."
    }
  }
}
